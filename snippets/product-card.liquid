{%- comment -%}
  Product card.
  Params: card_product (product), show_description (boolean)
{%- endcomment -%}

{%- if card_product != blank -%}
  <a href="{{ card_product.url }}" class="card card--lift product-card">
    <div class="product-card__media">
      {%- if card_product.featured_media -%}
        <img
          src="{{ card_product.featured_media | image_url: width: 600 }}"
          srcset="
            {{ card_product.featured_media | image_url: width: 300 }} 300w,
            {{ card_product.featured_media | image_url: width: 600 }} 600w
          "
          sizes="(min-width: 750px) 30vw, 90vw"
          alt="{{ card_product.featured_media.alt | default: card_product.title | escape }}"
          loading="lazy"
          width="{{ card_product.featured_media.width }}"
          height="{{ card_product.featured_media.height }}"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}

      {%- if card_product.compare_at_price > card_product.price -%}
        <span class="product-card__flag">
          {{ 'products.product.on_sale' | t: amount: card_product.compare_at_price | minus: card_product.price | money }}
        </span>
      {%- endif -%}
    </div>

    <div class="product-card__body">
      <p class="h3 product-card__title">{{ card_product.title }}</p>

      {%- if show_description and card_product.description != blank -%}
        <p class="product-card__desc">
          {{ card_product.description | strip_html | truncate: 110 }}
        </p>
      {%- endif -%}

      <p class="product-card__price">
        {%- if card_product.price_varies -%}
          {{ 'products.product.from_price' | t }}
        {%- endif -%}
        {{ card_product.price | money }}
        {%- if card_product.compare_at_price > card_product.price -%}
          <s>{{ card_product.compare_at_price | money }}</s>
        {%- endif -%}
      </p>

      <span class="btn btn--sm btn--ink product-card__cta">
        {{ 'products.product.view_details' | t }}
      </span>
    </div>
  </a>
{%- endif -%}

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    height: 100%;
  }

  .product-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #fff;
    border-bottom: 1px solid var(--cream-deep);
    display: grid;
    place-items: center;
    padding: 18px;
  }

  .product-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-card__flag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--gold);
    border: 1px solid var(--cream-deep);
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .product-card__body {
    padding: 20px;
    display: grid;
    gap: 10px;
    align-content: start;
    flex: 1;
  }

  .product-card__title {
    margin: 0;
  }

  .product-card__desc {
    margin: 0;
    font-size: 14px;
    opacity: 0.75;
  }

  .product-card__price {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.6rem;
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .product-card__price s {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    opacity: 0.5;
  }

  .product-card__cta {
    justify-self: start;
    margin-top: 4px;
  }
</style>
