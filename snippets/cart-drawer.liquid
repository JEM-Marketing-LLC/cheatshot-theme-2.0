{%- comment -%}
  Cart drawer shell. Contents are re-rendered from the
  `cart-drawer-content` section so quantity changes never need a page reload.
{%- endcomment -%}

<style>
  cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 900;
    pointer-events: none;
    visibility: hidden;
  }

  cart-drawer[data-open='true'] {
    pointer-events: auto;
    visibility: visible;
  }

  .drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(26, 26, 26, 0.55);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  cart-drawer[data-open='true'] .drawer__overlay {
    opacity: 1;
  }

  .drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(420px, 100%);
    background: var(--cream);
    border-left: 1px solid var(--cream-deep);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.25s cubic-bezier(0.32, 0.72, 0, 1);
  }

  cart-drawer[data-open='true'] .drawer__panel {
    transform: translateX(0);
  }

  .drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 22px;
    border-bottom: 1px solid var(--cream-deep);
  }

  .drawer__title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.6rem;
    margin: 0;
  }

  .drawer__close {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 1px solid var(--cream-deep);
    background: #fff;
  }

  .drawer__close svg {
    width: 18px;
    height: 18px;
    stroke: var(--ink);
    stroke-width: 3;
    fill: none;
  }

  .drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 22px;
  }

  .drawer__footer {
    border-top: 1px solid var(--cream-deep);
    padding: 20px 22px;
    background: #fff;
    display: grid;
    gap: 12px;
  }

  .drawer__line {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 14px;
    padding-bottom: 18px;
    margin-bottom: 18px;
    border-bottom: 2px solid rgba(26, 26, 26, 0.12);
  }

  .drawer__line:last-child {
    border-bottom: 0;
    margin-bottom: 0;
  }

  .drawer__line-image {
    width: 72px;
    height: 72px;
    border: 1px solid var(--cream-deep);
    background: #fff;
    display: grid;
    place-items: center;
    padding: 5px;
  }

  .drawer__line-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .drawer__line-title {
    font-weight: 700;
    margin: 0 0 2px;
    line-height: 1.25;
  }

  .drawer__line-variant {
    font-size: 13px;
    opacity: 0.65;
    margin: 0 0 8px;
  }

  .drawer__qty {
    display: inline-flex;
    border: 1px solid var(--cream-deep);
    background: #fff;
  }

  .drawer__qty button {
    width: 30px;
    height: 30px;
    border: 0;
    background: transparent;
    font-weight: 700;
    font-size: 16px;
    line-height: 1;
  }

  .drawer__qty span {
    width: 34px;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 14px;
    border-left: 1px solid var(--cream-deep);
    border-right: 1px solid var(--cream-deep);
  }

  .drawer__line-right {
    text-align: right;
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .drawer__line-price {
    font-weight: 700;
  }

  .drawer__remove {
    background: none;
    border: 0;
    padding: 0;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: underline;
    color: var(--red);
  }

  .drawer__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.5rem;
  }

  .drawer__empty {
    text-align: center;
    padding: 48px 0;
  }
</style>

<cart-drawer>
  <div class="drawer__overlay" data-drawer-close></div>

  <div class="drawer__panel" data-drawer-panel role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}">
    <div class="drawer__header">
      <p class="drawer__title">{{ 'cart.general.title' | t }}</p>
      <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div data-drawer-content>
      {% render 'cart-drawer-body' %}
    </div>
  </div>
</cart-drawer>
