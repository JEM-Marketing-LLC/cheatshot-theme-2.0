{%- comment -%}
  "Two formulas. Two jobs." — mirrors the live site's dual-role comparison.
{%- endcomment -%}

<style>
  #roles-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: clamp(56px, 8vw, 104px) 0;
  }

  #roles-{{ section.id }} .roles__head {
    text-align: center;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  #roles-{{ section.id }} .roles__eyebrow {
    display: inline-block;
    background: rgba(238, 44, 34, 0.08);
    color: var(--red);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  #roles-{{ section.id }} .roles__title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(40px, 5.5vw, 68px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }

  #roles-{{ section.id }} .roles__intro {
    font-size: 13px;
    line-height: 1.6;
    color: rgba(26, 26, 26, 0.6);
    max-width: 620px;
    margin: 16px auto 0;
  }

  #roles-{{ section.id }} .roles__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    #roles-{{ section.id }} .roles__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  #roles-{{ section.id }} .role {
    display: flex;
    flex-direction: column;
    background: var(--cream);
    border: 2px solid var(--cream-deep);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  #roles-{{ section.id }} .role:hover {
    border-color: rgba(238, 44, 34, 0.3);
    transform: translateY(-4px);
  }

  #roles-{{ section.id }} .role__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--cream-deep);
  }

  #roles-{{ section.id }} .role__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #roles-{{ section.id }} .role__tag {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(6px);
    border-radius: 8px;
    padding: 8px 16px;
  }

  #roles-{{ section.id }} .role__tag-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mid);
  }

  #roles-{{ section.id }} .role__tag-value {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
    color: var(--ink);
  }

  #roles-{{ section.id }} .role__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(24px, 3vw, 36px);
  }

  #roles-{{ section.id }} .role__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  #roles-{{ section.id }} .role__name {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1;
    margin: 0;
  }

  #roles-{{ section.id }} .role__price {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 26px;
  }

  #roles-{{ section.id }} .role__points {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  #roles-{{ section.id }} .role__points li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-mid);
  }

  #roles-{{ section.id }} .role__points li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--red);
    margin-top: 8px;
    flex: none;
  }

  #roles-{{ section.id }} .role__mindset {
    font-size: 15px;
    font-style: italic;
    color: var(--ink-mid);
    margin: 0 0 24px;
  }

  #roles-{{ section.id }} .role__cta {
    margin-top: auto;
    align-self: flex-start;
  }

  #roles-{{ section.id }} .roles__footer {
    margin-top: clamp(40px, 5vw, 64px);
  }

  #roles-{{ section.id }} .roles__rule {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 720px;
    margin: 0 auto;
  }

  #roles-{{ section.id }} .roles__rule span:first-child,
  #roles-{{ section.id }} .roles__rule span:last-child {
    flex: 1;
    height: 1px;
    background: var(--cream-deep);
  }

  #roles-{{ section.id }} .roles__rule-text {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 13px;
    text-align: center;
    color: rgba(26, 26, 26, 0.7);
  }

  @media screen and (min-width: 750px) {
    #roles-{{ section.id }} .roles__rule-text {
      font-size: 16px;
    }
  }

  #roles-{{ section.id }} .roles__closing {
    text-align: center;
    margin-top: 32px;
  }

  #roles-{{ section.id }} .roles__closing p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-mid);
    max-width: 560px;
    margin: 0 auto 24px;
  }
</style>

<section id="roles-{{ section.id }}" aria-labelledby="roles-heading-{{ section.id }}">
  <div class="wrap">
    <div class="roles__head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <span class="roles__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="roles__title" id="roles-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="roles__intro">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    <div class="roles__grid">
      {%- for block in section.blocks -%}
        <article class="role" data-reveal style="transition-delay: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
          <div class="role__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 900 }}"
                srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w"
                sizes="(min-width: 750px) 46vw, 100vw"
                alt="{{ block.settings.image.alt | default: block.settings.image_alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {%- elsif block.settings.fallback_asset != blank -%}
              <img
                src="{{ block.settings.fallback_asset | asset_url }}"
                alt="{{ block.settings.image_alt | escape }}"
                loading="lazy"
                width="900"
                height="562"
              >
            {%- endif -%}

            {%- if block.settings.role != blank -%}
              <div class="role__tag">
                <div class="role__tag-label">{{ section.settings.role_label | default: 'Role' | escape }}</div>
                <div class="role__tag-value">{{ block.settings.role | escape }}</div>
              </div>
            {%- endif -%}
          </div>

          <div class="role__body">
            <div class="role__row">
              <h3 class="role__name">{{ block.settings.name | escape }}</h3>
              {%- if block.settings.product != blank -%}
                <span class="role__price">{{ block.settings.product.price | money }}</span>
              {%- elsif block.settings.price != blank -%}
                <span class="role__price">{{ block.settings.price | escape }}</span>
              {%- endif -%}
            </div>

            <ul class="role__points">
              {%- if block.settings.point_1 != blank -%}<li>{{ block.settings.point_1 }}</li>{%- endif -%}
              {%- if block.settings.point_2 != blank -%}<li>{{ block.settings.point_2 }}</li>{%- endif -%}
              {%- if block.settings.point_3 != blank -%}<li>{{ block.settings.point_3 }}</li>{%- endif -%}
            </ul>

            {%- if block.settings.mindset != blank -%}
              <p class="role__mindset">{{ block.settings.mindset }}</p>
            {%- endif -%}

            {%- assign role_url = block.settings.link -%}
            {%- if role_url == blank and block.settings.product != blank -%}
              {%- assign role_url = block.settings.product.url -%}
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <a
                href="{{ role_url | default: routes.all_products_collection_url }}"
                class="btn role__cta{% unless block.settings.primary %} btn--outline{% endunless %}"
              >{{ block.settings.cta_label | escape }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.rule_text != blank or section.settings.closing_body != blank -%}
      <div class="roles__footer" data-reveal>
        {%- if section.settings.rule_text != blank -%}
          <div class="roles__rule">
            <span aria-hidden="true"></span>
            <span class="roles__rule-text">{{ section.settings.rule_text | escape }}</span>
            <span aria-hidden="true"></span>
          </div>
        {%- endif -%}

        <div class="roles__closing">
          {%- if section.settings.closing_body != blank -%}
            <p>{{ section.settings.closing_body }}</p>
          {%- endif -%}
          {%- if section.settings.closing_cta_label != blank -%}
            <a href="{{ section.settings.closing_cta_link | default: routes.all_products_collection_url }}" class="btn">
              {{ section.settings.closing_cta_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Two formulas",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Two formulas. Two jobs." },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Daily foundation + cheat meals." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Cheat Shot is a dual-purpose dietary supplement system built to support healthy glucose metabolism. The powder is your foundation; taken daily, it supports healthy metabolic function and is rich in antioxidants. The capsules are designed to support your digestion when you need it most — think carb-heavy meals that usually leave you feeling heavy. Take each as directed on the label, as part of a balanced diet and active lifestyle.*"
    },
    { "type": "text", "id": "role_label", "label": "Card tag label", "default": "Role" },
    { "type": "header", "content": "Closing band" },
    { "type": "text", "id": "rule_text", "label": "Divider text", "default": "Healthy glucose metabolism" },
    {
      "type": "textarea",
      "id": "closing_body",
      "label": "Closing body",
      "default": "Daily Foundation + Cheat Meal Support — daily metabolic support and antioxidants, plus digestive support when you need it.*"
    },
    {
      "type": "text",
      "id": "closing_cta_label",
      "label": "Closing button label",
      "default": "Get the Bundle — Save $17.99 vs Buying Separately"
    },
    { "type": "url", "id": "closing_cta_link", "label": "Closing button link" },
    { "type": "header", "content": "Styling" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "role",
      "name": "Formula",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "role", "label": "Role", "default": "Every day" },
        { "type": "text", "id": "name", "label": "Name", "default": "Powder" },
        { "type": "product", "id": "product", "label": "Product", "info": "Price and link come from this product when set." },
        { "type": "text", "id": "price", "label": "Fallback price" },
        { "type": "url", "id": "link", "label": "Fallback link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Bundled image file name", "info": "Used when no image is selected, e.g. lifestyle-powder-shaker.webp" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "point_1", "label": "Point 1" },
        { "type": "text", "id": "point_2", "label": "Point 2" },
        { "type": "text", "id": "point_3", "label": "Point 3" },
        { "type": "textarea", "id": "mindset", "label": "Quote" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop now →" },
        { "type": "checkbox", "id": "primary", "label": "Red button", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Two formulas",
      "blocks": [{ "type": "role" }, { "type": "role" }]
    }
  ]
}
{% endschema %}
