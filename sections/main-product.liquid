<style>
  #product-{{ section.id }} {
    padding: clamp(28px, 4vw, 56px) 0 clamp(48px, 6vw, 80px);
  }

  .pdp {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media screen and (min-width: 900px) {
    .pdp {
      grid-template-columns: 1.05fr 1fr;
    }
  }

  .pdp__gallery {
    position: relative;
  }

  .pdp__main-image {
    border: 1px solid var(--cream-deep);
    background: #fff;
    box-shadow: var(--shadow-gold);
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .pdp__main-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 24px;
  }

  .pdp__thumbs {
    display: flex;
    gap: 12px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .pdp__thumb {
    width: 84px;
    height: 84px;
    border: 1px solid var(--cream-deep);
    background: #fff;
    padding: 6px;
    display: grid;
    place-items: center;
  }

  .pdp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pdp__thumb[aria-current='true'] {
    box-shadow: 4px 4px 0 0 var(--red);
  }

  .pdp__subtitle {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 13px;
    color: var(--red);
    margin: 0;
  }

  .pdp__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-display);
  }

  .pdp__price {
    font-size: 2.6rem;
    font-weight: 900;
  }

  .pdp__compare {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: line-through;
    opacity: 0.55;
  }

  .pdp__save {
    background: var(--gold);
    border: 1px solid var(--cream-deep);
    padding: 4px 10px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .option {
    display: grid;
    gap: 10px;
  }

  .option__label {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1rem;
    letter-spacing: 0.08em;
  }

  .option__values {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .option__value {
    position: relative;
  }

  .option__value input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }

  .option__value span {
    display: block;
    border: 1px solid var(--cream-deep);
    background: #fff;
    padding: 11px 20px;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.05rem;
    transition: background 0.12s ease, color 0.12s ease;
  }

  .option__value input:checked + span {
    background: var(--ink);
    color: #fff;
  }

  .option__value input:focus-visible + span {
    outline: 3px solid var(--red);
    outline-offset: 2px;
  }

  .pdp__error {
    border: 3px solid var(--red);
    background: #fff;
    color: var(--red);
    padding: 12px 16px;
    font-weight: 700;
    font-size: 14px;
  }

  .pdp__secure {
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    opacity: 0.7;
  }

  .btn.is-loading {
    opacity: 0.7;
    pointer-events: none;
  }

  .pdp__description {
    border-top: 1px solid var(--cream-deep);
    padding-top: 22px;
  }

  .pdp__description :is(p, ul, ol) {
    margin: 0 0 14px;
  }

  .crosssell {
    border: 1px solid var(--cream-deep);
    background: var(--yellow);
    padding: 18px 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    justify-content: space-between;
  }

  .crosssell__text {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.3rem;
    line-height: 1;
    margin: 0;
  }

  .crosssell__note {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    text-transform: none;
    display: block;
    margin-top: 4px;
  }
</style>

<section id="product-{{ section.id }}" aria-labelledby="pdp-title-{{ section.id }}">
  <div class="wrap">
    <div class="pdp">
      {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
      <div class="pdp__gallery">
        <div class="pdp__main-image">
          {%- if product.featured_media -%}
            <img
              id="PdpMainImage-{{ section.id }}"
              src="{{ product.featured_media | image_url: width: 900 }}"
              srcset="
                {{ product.featured_media | image_url: width: 500 }} 500w,
                {{ product.featured_media | image_url: width: 700 }} 700w,
                {{ product.featured_media | image_url: width: 900 }} 900w
              "
              sizes="(min-width: 900px) 46vw, 92vw"
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              width="{{ product.featured_media.width }}"
              height="{{ product.featured_media.height }}"
              fetchpriority="high"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="pdp__thumbs" role="group" aria-label="Product images">
            {%- for media in product.media limit: 6 -%}
              <button
                type="button"
                class="pdp__thumb"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="Show image {{ forloop.index }}"
                data-thumb
                data-full="{{ media | image_url: width: 900 }}"
                data-target="PdpMainImage-{{ section.id }}"
              >
                <img
                  src="{{ media | image_url: width: 160 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="160"
                  height="160"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- Buy panel ---------- {%- endcomment -%}
      <div class="stack">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'title' -%}
              <div class="stack stack--sm" {{ block.shopify_attributes }}>
                <h1 class="h1" id="pdp-title-{{ section.id }}">{{ product.title }}</h1>
                {%- if block.settings.subtitle != blank -%}
                  <p class="pdp__subtitle">{{ block.settings.subtitle | escape }}</p>
                {%- endif -%}
              </div>

            {%- when 'summary' -%}
              <p class="lede" {{ block.shopify_attributes }}>
                {{ block.settings.text | default: product.description | strip_html | truncate: 300 }}
              </p>

            {%- when 'price' -%}
              <div {{ block.shopify_attributes }}>
                <div class="pdp__price-row">
                  <span class="pdp__price" data-price-target>{{ product.selected_or_first_available_variant.price | money }}</span>
                  {%- assign v = product.selected_or_first_available_variant -%}
                  <span
                    class="pdp__compare"
                    data-compare-target
                    {% unless v.compare_at_price > v.price %}hidden{% endunless %}
                  >{{ v.compare_at_price | money }}</span>
                  {%- if v.compare_at_price > v.price -%}
                    {%- assign saved = v.compare_at_price | minus: v.price -%}
                    <span class="pdp__save">{{ 'products.product.on_sale' | t: amount: saved | money }}</span>
                  {%- endif -%}
                </div>
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <div class="option">
                      <span class="option__label">{{ option.name }}</span>
                      <div class="option__values">
                        {%- for value in option.values -%}
                          <label class="option__value">
                            <input
                              type="radio"
                              name="option-{{ section.id }}-{{ option.position }}"
                              value="{{ value | escape }}"
                              {% if option.selected_value == value %}checked{% endif %}
                            >
                            <span>{{ value }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endfor -%}

                  <script type="application/json" data-variant-json>
                    [
                      {%- for variant in product.variants -%}
                        {
                          "id": {{ variant.id }},
                          "options": {{ variant.options | json }},
                          "price": {{ variant.price }},
                          "compare_at_price": {{ variant.compare_at_price | default: 0 }},
                          "available": {{ variant.available }}
                        }{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    ]
                  </script>
                </variant-picker>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <product-form {{ block.shopify_attributes }}>
                <p class="pdp__error" data-cart-error hidden role="alert"></p>

                {%- form 'product', product, novalidate: 'novalidate' -%}
                  <input
                    type="hidden"
                    name="id"
                    value="{{ product.selected_or_first_available_variant.id }}"
                  >
                  <input type="hidden" name="quantity" value="1">

                  <button
                    type="submit"
                    class="btn btn--block"
                    data-add-button
                    {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                  >
                    <span data-add-label>
                      {%- if product.selected_or_first_available_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>
                {%- endform -%}

                <p class="pdp__secure" style="margin-top:10px">{{ 'products.product.secure_checkout' | t }}</p>
              </product-form>

            {%- when 'trust_badges' -%}
              <div class="trust-row" {{ block.shopify_attributes }}>
                {%- assign badges = block.settings.badges | split: ',' -%}
                {%- for badge in badges -%}
                  <span class="trust-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                      <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {{ badge | strip }}
                  </span>
                {%- endfor -%}
              </div>

            {%- when 'crosssell' -%}
              {%- assign bundle = all_products[block.settings.product] -%}
              {%- if bundle != blank and bundle.handle != product.handle -%}
                <div class="crosssell" {{ block.shopify_attributes }}>
                  <p class="crosssell__text">
                    {{ block.settings.heading | escape }}
                    <span class="crosssell__note">{{ bundle.title }} &middot; {{ bundle.price | money }}</span>
                  </p>
                  <a href="{{ bundle.url }}" class="btn btn--sm btn--ink">{{ block.settings.link_label | escape }}</a>
                </div>
              {%- endif -%}

            {%- when 'description' -%}
              <div class="pdp__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>

            {%- when 'disclaimer' -%}
              {%- if settings.fda_disclaimer != blank -%}
                <p class="fine-print" {{ block.shopify_attributes }}>{{ settings.fda_disclaimer }}</p>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
  // Thumbnail swap — scoped to this section, no dependency on theme.js.
  document.querySelectorAll('#product-{{ section.id }} [data-thumb]').forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      var target = document.getElementById(thumb.dataset.target);
      if (!target) return;
      target.src = thumb.dataset.full;
      target.removeAttribute('srcset');
      document
        .querySelectorAll('#product-{{ section.id }} [data-thumb]')
        .forEach(function (other) {
          other.setAttribute('aria-current', String(other === thumb));
        });
    });
  });
</script>

{% schema %}
{
  "name": "Product details",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "info": "Short line under the product name, e.g. \"30 doses · capsules\"."
        }
      ]
    },
    {
      "type": "summary",
      "name": "Summary",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Summary text",
          "info": "Leave blank to use the start of the product description."
        }
      ]
    },
    { "type": "price", "name": "Price", "limit": 1, "settings": [] },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [] },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [] },
    {
      "type": "trust_badges",
      "name": "Trust badges",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "badges",
          "label": "Badges",
          "info": "Comma separated.",
          "default": "GMP Certified, Third-Party Tested, Made in USA"
        }
      ]
    },
    {
      "type": "crosssell",
      "name": "Bundle cross-sell",
      "limit": 1,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product to promote"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Want both formats?"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "See the bundle"
        }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1, "settings": [] },
    { "type": "disclaimer", "name": "FDA disclaimer", "limit": 1, "settings": [] }
  ]
}
{% endschema %}
