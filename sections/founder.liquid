{%- comment -%}"Built from scratch" founder block on ink background.{%- endcomment -%}
<style>
  #founder-{{ section.id }} {
    background: var(--ink);
    padding: clamp(56px, 8vw, 104px) 0;
  }

  #founder-{{ section.id }} .founder__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    #founder-{{ section.id }} .founder__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  #founder-{{ section.id }} .founder__media {
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
  }

  #founder-{{ section.id }} .founder__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  #founder-{{ section.id }} .founder__eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 12px;
  }

  #founder-{{ section.id }} .founder__title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--gold);
    margin: 0 0 16px;
  }

  #founder-{{ section.id }} .founder__copy p {
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 12px;
  }

  #founder-{{ section.id }} .founder__cta {
    margin-top: 12px;
  }
</style>

<section id="founder-{{ section.id }}" aria-labelledby="founder-h2-{{ section.id }}">
  <div class="wrap">
    <div class="founder__grid">
      <div class="founder__media" data-reveal>
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.image_alt }}
        {%- elsif section.settings.fallback_asset != blank -%}
          <img src="{{ section.settings.fallback_asset | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="900" height="1125">
        {%- endif -%}
      </div>
      <div class="founder__copy" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <span class="founder__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="founder__title" id="founder-h2-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {{ section.settings.body }}
        <a class="btn founder__cta" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | escape }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founder",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename", "default": "joey-thurman.webp" },
    { "type": "text", "id": "image_alt", "label": "Image alt", "default": "Joey Thurman" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Not a celebrity. An actual expert." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built from scratch" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Try It →" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Founder" }]
}
{% endschema %}
