{%- comment -%}"Two formulas. Two jobs." definition block from the live /about page.{%- endcomment -%}
<style>
  #abtdef-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: clamp(56px, 8vw, 104px) 0;
  }

  #abtdef-{{ section.id }} .abtdef__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    #abtdef-{{ section.id }} .abtdef__grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  #abtdef-{{ section.id }} .abtdef__title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(28px, 3.5vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  #abtdef-{{ section.id }} .abtdef__copy p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-mid);
    margin: 0 0 12px;
  }

  #abtdef-{{ section.id }} .abtdef__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  #abtdef-{{ section.id }} .abtdef__cards {
    display: grid;
    gap: 12px;
  }

  #abtdef-{{ section.id }} .abtdef__card {
    border-radius: 12px;
    padding: 24px;
  }

  #abtdef-{{ section.id }} .abtdef__card--yellow {
    background: var(--yellow);
  }

  #abtdef-{{ section.id }} .abtdef__card--ink {
    background: var(--ink);
    color: #fff;
  }

  #abtdef-{{ section.id }} .abtdef__icon {
    display: block;
    font-size: 40px;
    line-height: 1;
    margin-bottom: 8px;
  }

  #abtdef-{{ section.id }} .abtdef__card h3 {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 4px;
  }

  #abtdef-{{ section.id }} .abtdef__card p {
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
    color: rgba(26, 26, 26, 0.6);
  }

  #abtdef-{{ section.id }} .abtdef__card--ink p {
    color: rgba(255, 255, 255, 0.55);
  }
</style>

<section id="abtdef-{{ section.id }}" aria-labelledby="abtdef-h2-{{ section.id }}">
  <div class="wrap">
    <div class="abtdef__grid">
      <div class="abtdef__copy" data-reveal>
        <h2 class="abtdef__title" id="abtdef-h2-{{ section.id }}">{{ section.settings.heading }}</h2>
        {{ section.settings.body }}
        <div class="abtdef__badges">
          {%- assign badges = section.settings.badges | split: ',' -%}
          {%- for badge in badges -%}
            <span class="trust-badge">✓ {{ badge | strip | escape }}</span>
          {%- endfor -%}
        </div>
        <p class="fine-print" style="margin-top:16px">{{ section.settings.disclaimer | escape }}</p>
      </div>

      <div class="abtdef__cards" data-reveal>
        <div class="abtdef__card abtdef__card--yellow">
          <span class="abtdef__icon" aria-hidden="true">{{ section.settings.card_1_icon }}</span>
          <h3>{{ section.settings.card_1_title | escape }}</h3>
          <p>{{ section.settings.card_1_body | escape }}</p>
        </div>
        <div class="abtdef__card abtdef__card--ink">
          <span class="abtdef__icon" aria-hidden="true">{{ section.settings.card_2_icon }}</span>
          <h3>{{ section.settings.card_2_title | escape }}</h3>
          <p>{{ section.settings.card_2_body | escape }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About definition",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two Formulas. Two Jobs." },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "badges", "label": "Trust badges (comma separated)", "default": "GMP Certified, Third-Party Tested, Made in USA, No Stimulants" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "*These statements have not been evaluated by the FDA." },
    { "type": "text", "id": "card_1_icon", "label": "Card 1 icon", "default": "⏱️" },
    { "type": "text", "id": "card_1_title", "label": "Card 1 title", "default": "15 minutes before" },
    { "type": "textarea", "id": "card_1_body", "label": "Card 1 body" },
    { "type": "text", "id": "card_2_icon", "label": "Card 2 icon", "default": "🍽️" },
    { "type": "text", "id": "card_2_title", "label": "Card 2 title", "default": "With or after works too" },
    { "type": "textarea", "id": "card_2_body", "label": "Card 2 body" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "About definition" }]
}
{% endschema %}
