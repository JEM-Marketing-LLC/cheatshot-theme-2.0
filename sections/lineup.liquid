{%- comment -%}"The Lineup" — three pricing cards, matching the live /about lineup.{%- endcomment -%}
<style>
  #lineup-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: clamp(56px, 8vw, 104px) 0;
  }

  #lineup-{{ section.id }} .lineup__inner {
    text-align: center;
  }

  #lineup-{{ section.id }} .lineup__title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(32px, 4.5vw, 48px);
    letter-spacing: -0.02em;
    margin: 0 0 32px;
  }

  #lineup-{{ section.id }} .lineup__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    max-width: 960px;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    #lineup-{{ section.id }} .lineup__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  #lineup-{{ section.id }} .lineup__card {
    position: relative;
    background: #fff;
    border-radius: 12px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #lineup-{{ section.id }} .lineup__card--primary {
    box-shadow: inset 0 0 0 2px var(--red);
  }

  #lineup-{{ section.id }} .lineup__badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--ink);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }

  #lineup-{{ section.id }} .lineup__card img {
    height: 160px;
    object-fit: contain;
    margin-bottom: 16px;
  }

  #lineup-{{ section.id }} .lineup__card h3 {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0 0 4px;
  }

  #lineup-{{ section.id }} .lineup__price {
    font-size: 14px;
    color: var(--ink-mid);
    margin: 0 0 4px;
  }

  #lineup-{{ section.id }} .lineup__desc {
    font-size: 13px;
    line-height: 1.45;
    color: rgba(26, 26, 26, 0.55);
    margin: 0 0 16px;
    min-height: 36px;
  }

  #lineup-{{ section.id }} .lineup__cta {
    margin-top: auto;
    font-size: 13px;
    padding: 10px 20px;
  }
</style>

<section id="lineup-{{ section.id }}" aria-labelledby="lineup-h2-{{ section.id }}">
  <div class="wrap lineup__inner">
    <h2 class="lineup__title" id="lineup-h2-{{ section.id }}">{{ section.settings.heading }}</h2>
    <div class="lineup__grid">
      {%- for block in section.blocks -%}
        {%- assign card_product = all_products[block.settings.product] -%}
        {%- if card_product != blank and card_product.available -%}
          {%- assign card_url = card_product.url -%}
          {%- assign card_price = card_product.price | money -%}
        {%- else -%}
          {%- assign card_url = block.settings.fallback_url | default: routes.all_products_collection_url -%}
          {%- assign card_price = block.settings.price -%}
        {%- endif -%}
        <div class="lineup__card{% if block.settings.primary %} lineup__card--primary{% endif %}" data-reveal style="transition-delay:{{ forloop.index0 | times: 70 }}ms" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}
            <span class="lineup__badge">{{ block.settings.badge | escape }}</span>
          {%- endif -%}
          {%- if card_product != blank and card_product.featured_image -%}
            {{ card_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}
          {%- elsif block.settings.fallback_asset != blank -%}
            <img src="{{ block.settings.fallback_asset | asset_url }}" alt="Cheat Shot {{ block.settings.title | escape }}" loading="lazy" width="500" height="500">
          {%- endif -%}
          <h3>{{ block.settings.title | escape }}</h3>
          <p class="lineup__price">{{ card_price }}</p>
          <p class="lineup__desc">{{ block.settings.body | escape }}</p>
          <a class="btn lineup__cta {% unless block.settings.primary %}btn--outline{% endunless %}" href="{{ card_url }}">{{ block.settings.cta_label | escape }}</a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The lineup",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Lineup" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FBF7EC" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Title", "default": "Single Bottle" },
        { "type": "text", "id": "price", "label": "Fallback price", "default": "$37.99" },
        { "type": "textarea", "id": "body", "label": "Description" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Single" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename" },
        { "type": "url", "id": "fallback_url", "label": "Fallback link" },
        { "type": "checkbox", "id": "primary", "label": "Highlight this card", "default": false }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "The lineup" }]
}
{% endschema %}
