<style>
  .collection {
    padding: clamp(32px, 5vw, 64px) 0 clamp(48px, 6vw, 88px);
  }

  .collection__head {
    display: grid;
    gap: 14px;
    max-width: 60ch;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .collection__grid {
    display: grid;
    gap: clamp(20px, 3vw, 32px);
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 700px) {
    .collection__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1000px) {
    .collection__grid {
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    }
  }

  .collection__empty {
    border: 3px dashed var(--ink);
    padding: 48px 24px;
    text-align: center;
  }

  .pagination {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin-top: 48px;
  }

  .pagination a,
  .pagination span {
    border: 1px solid var(--cream-deep);
    background: #fff;
    padding: 8px 14px;
    font-weight: 700;
  }

  .pagination .current {
    background: var(--ink);
    color: #fff;
  }
</style>

<section class="collection">
  <div class="wrap">
    <div class="collection__head">
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'Shop' | escape }}</span>
      <h1 class="h1">{{ collection.title | default: 'All products' }}</h1>
      {%- if collection.description != blank -%}
        <div class="lede rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size > 0 -%}
        <div class="collection__grid">
          {%- for product in collection.products -%}
            <div data-reveal style="transition-delay: {{ forloop.index0 | modulo: 3 | times: 70 }}ms">
              {% render 'product-card', card_product: product, show_description: section.settings.show_description %}
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="collection__empty">
          <p class="h3">No products found</p>
          <p class="fine-print" style="margin-top:10px">
            There are no products in this collection yet.
          </p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    { "type": "checkbox", "id": "show_description", "label": "Show short description", "default": true }
  ]
}
{% endschema %}
