<style>
  .search-page {
    padding: clamp(32px, 5vw, 64px) 0 clamp(48px, 6vw, 88px);
  }

  .search-form {
    display: flex;
    gap: 0;
    max-width: 560px;
    margin: 24px 0 40px;
  }

  .search-form input {
    flex: 1;
    border: 1px solid var(--cream-deep);
    border-right: 0;
    padding: 12px 14px;
    font-family: inherit;
    font-size: 16px;
    background: #fff;
  }

  .search-grid {
    display: grid;
    gap: clamp(20px, 3vw, 32px);
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 700px) {
    .search-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<section class="search-page">
  <div class="wrap">
    <h1 class="h1">{{ 'general.search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        aria-label="{{ 'general.search.placeholder' | t }}"
      >
      <button type="submit" class="btn">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="fine-print" style="margin-bottom:24px">
          {{ search.results_count }} {{ 'general.search.results' | t }}
        </p>
        <div class="search-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item, show_description: false %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="lede">{{ 'general.search.no_results' | t }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "settings": []
}
{% endschema %}
