{%- comment -%}Ingredient breakdown for one formula — bottle + intro + dosed cards.{%- endcomment -%}
<style>
  #inglist-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: clamp(48px, 6vw, 80px) 0;
  }

  #inglist-{{ section.id }} .inglist__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 4vw, 48px);
    align-items: center;
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  @media screen and (min-width: 750px) {
    #inglist-{{ section.id }} .inglist__head {
      grid-template-columns: 220px minmax(0, 1fr);
    }

    #inglist-{{ section.id }} .inglist__bottle {
      position: sticky;
      top: 80px;
    }
  }

  #inglist-{{ section.id }} .inglist__bottle {
    background: #fff;
    border-radius: 12px;
    min-height: 236px;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #inglist-{{ section.id }} .inglist__bottle img {
    width: 100%;
    height: 196px;
    object-fit: contain;
  }

  #inglist-{{ section.id }} .inglist__title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }

  #inglist-{{ section.id }} .inglist__intro {
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-mid);
    margin: 0 0 8px;
  }

  #inglist-{{ section.id }} .inglist__other {
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-light);
    margin: 0 0 8px;
  }

  #inglist-{{ section.id }} .inglist__link {
    color: var(--red);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  #inglist-{{ section.id }} .inglist__link:hover {
    text-decoration: underline;
  }

  #inglist-{{ section.id }} .inglist__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    #inglist-{{ section.id }} .inglist__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  #inglist-{{ section.id }} .ing {
    background: #fff;
    border: 1px solid var(--cream-deep);
    border-radius: 12px;
    padding: 22px;
    transition: border-color 0.2s ease;
  }

  #inglist-{{ section.id }} .ing:hover {
    border-color: rgba(238, 44, 34, 0.3);
  }

  #inglist-{{ section.id }} .ing__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 8px;
  }

  #inglist-{{ section.id }} .ing__name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0;
  }

  #inglist-{{ section.id }} .ing__emoji {
    font-size: 24px;
    line-height: 1;
  }

  #inglist-{{ section.id }} .ing__dose {
    color: var(--red);
    font-size: 13px;
    font-weight: 900;
    white-space: nowrap;
  }

  #inglist-{{ section.id }} .ing__tagline {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-mid);
    margin: 0 0 8px;
  }

  #inglist-{{ section.id }} .ing__body {
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-mid);
    margin: 0 0 12px;
  }

  #inglist-{{ section.id }} .ing__source {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-light);
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #inglist-{{ section.id }} {
      padding: 44px 0 52px;
    }

    #inglist-{{ section.id }} .inglist__head {
      gap: 24px;
      margin-bottom: 28px;
    }

    #inglist-{{ section.id }} .inglist__bottle {
      min-height: 0;
      padding: 18px;
    }

    #inglist-{{ section.id }} .inglist__bottle img {
      height: 190px;
    }

    #inglist-{{ section.id }} .ing {
      padding: 20px;
    }

    #inglist-{{ section.id }} .ing__row {
      align-items: flex-start;
    }
  }
</style>

<section id="inglist-{{ section.id }}" aria-labelledby="inglist-h2-{{ section.id }}">
  <div class="wrap">
    <div class="inglist__head">
      <div class="inglist__bottle">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: section.settings.heading }}
        {%- elsif section.settings.fallback_asset != blank -%}
          <img src="{{ section.settings.fallback_asset | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="600" height="600">
        {%- endif -%}
      </div>
      <div>
        <h2 class="inglist__title" id="inglist-h2-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <p class="inglist__intro">{{ section.settings.intro | escape }}</p>
        {%- if section.settings.other_ingredients != blank -%}
          <p class="inglist__other">{{ section.settings.other_ingredients | escape }}</p>
        {%- endif -%}
        {%- assign linked_product = all_products[section.settings.product] -%}
        {%- if linked_product != blank and linked_product.available -%}
          {%- assign shop_url = linked_product.url -%}
        {%- else -%}
          {%- assign shop_url = section.settings.cta_url | default: routes.all_products_collection_url -%}
        {%- endif -%}
        <a class="inglist__link" href="{{ shop_url }}">{{ section.settings.cta_label | escape }}</a>
      </div>
    </div>

    <div class="inglist__grid">
      {%- for block in section.blocks -%}
        <article class="ing" data-reveal style="transition-delay:{{ forloop.index0 | modulo: 2 | times: 70 }}ms" {{ block.shopify_attributes }}>
          <div class="ing__row">
            <h3 class="ing__name">
              <span class="ing__emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
              {{ block.settings.name | escape }}
            </h3>
            <span class="ing__dose">{{ block.settings.dose | escape }}</span>
          </div>
          <p class="ing__tagline">{{ block.settings.tagline | escape }}</p>
          <p class="ing__body">{{ block.settings.body | escape }}</p>
          <p class="ing__source">{{ block.settings.source | escape }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredient list",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cheat Shot Capsules" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "textarea", "id": "other_ingredients", "label": "Other ingredients" },
    { "type": "product", "id": "product", "label": "Linked product" },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Shop Capsules →" },
    { "type": "url", "id": "cta_url", "label": "Fallback link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename", "default": "bottle-tall.webp" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FBF7EC" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "⚡" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "dose", "label": "Dose" },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "text", "id": "source", "label": "Source" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Ingredient list" }]
}
{% endschema %}
