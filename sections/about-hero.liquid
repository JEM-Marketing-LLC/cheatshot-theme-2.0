{%- comment -%}About hero — mirrors the live /about yellow hero.{%- endcomment -%}
<style>
  #abouthero-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: clamp(48px, 7vw, 88px) 0;
  }

  #abouthero-{{ section.id }} .abouthero__inner {
    text-align: center;
  }

  #abouthero-{{ section.id }} .abouthero__badge {
    display: inline-block;
    background: var(--ink);
    color: #fff;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 8px 16px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  #abouthero-{{ section.id }} .abouthero__title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(44px, 6vw, 76px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  #abouthero-{{ section.id }} .abouthero__body {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(26, 26, 26, 0.6);
    max-width: 520px;
    margin: 0 auto;
  }
</style>

<section id="abouthero-{{ section.id }}" aria-labelledby="abouthero-h1-{{ section.id }}">
  <div class="wrap abouthero__inner">
    {%- if section.settings.badge != blank -%}
      <span class="abouthero__badge">{{ section.settings.badge | escape }}</span>
    {%- endif -%}
    <h1 class="abouthero__title" id="abouthero-h1-{{ section.id }}">{{ section.settings.heading }}</h1>
    {%- if section.settings.body != blank -%}
      <p class="abouthero__body">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "THE TLDR VERSION" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>What is Cheat Shot?</p>" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFCC33" }
  ],
  "presets": [{ "name": "About hero" }]
}
{% endschema %}
