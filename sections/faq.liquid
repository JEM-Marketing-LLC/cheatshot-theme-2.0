<style>
  #faq-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: clamp(52px, 7vw, 96px) 0;
  }

  #faq-{{ section.id }} .faq__head {
    max-width: 56ch;
    margin-bottom: clamp(24px, 4vw, 40px);
    display: grid;
    gap: 12px;
  }

  #faq-{{ section.id }} .faq__list {
    display: grid;
    gap: 12px;
    max-width: 900px;
  }

  #faq-{{ section.id }} details {
    border: 1px solid var(--cream-deep);
    background: #fff;
  }

  #faq-{{ section.id }} summary {
    cursor: pointer;
    list-style: none;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.2rem;
    line-height: 1.1;
  }

  #faq-{{ section.id }} summary::-webkit-details-marker {
    display: none;
  }

  #faq-{{ section.id }} .faq__icon {
    flex: none;
    width: 26px;
    height: 26px;
    border: 1px solid var(--cream-deep);
    display: grid;
    place-items: center;
    font-size: 18px;
    line-height: 1;
  }

  #faq-{{ section.id }} details[open] .faq__icon {
    background: var(--red);
    color: #fff;
    border-color: var(--red);
  }

  #faq-{{ section.id }} .faq__answer {
    padding: 0 20px 20px;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
  }
</style>

<section id="faq-{{ section.id }}" aria-labelledby="faq-heading-{{ section.id }}">
  <div class="wrap">
    <div class="faq__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="h1" id="faq-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>

    <disclosure-list class="faq__list" data-exclusive="{{ section.settings.exclusive }}">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question | escape }}</span>
            <span class="faq__icon" aria-hidden="true">+</span>
          </summary>
          <p class="faq__answer">{{ block.settings.answer }}</p>
        </details>
      {%- endfor -%}
    </disclosure-list>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The stuff people ask."
    },
    {
      "type": "checkbox",
      "id": "exclusive",
      "label": "Only one answer open at a time",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FDFCF8"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
