<section style="padding: clamp(64px, 10vw, 140px) 0; text-align: center;">
  <div class="wrap">
    <p class="h-display" style="color: var(--red)">404</p>
    <h1 class="h1" style="margin-top:12px">{{ 'general.404.title' | t }}</h1>
    <p class="lede measure mx-auto" style="margin-top:14px">{{ 'general.404.subtext' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn" style="margin-top:28px">
      {{ 'general.404.link' | t }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "tag": "section",
  "settings": []
}
{% endschema %}
