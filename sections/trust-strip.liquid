{%- comment -%}"Held to a higher standard." trust strip on ink background.{%- endcomment -%}
<style>
  #trust-{{ section.id }} {
    background: var(--ink);
    padding: clamp(52px, 6vw, 80px) 0;
    text-align: center;
  }

  #trust-{{ section.id }} .trust__title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(28px, 3.5vw, 42px);
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 12px;
  }

  #trust-{{ section.id }} .trust__body {
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.5);
    max-width: 520px;
    margin: 0 auto 32px;
  }

  #trust-{{ section.id }} .trust__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  #trust-{{ section.id }} .trust__badge {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 8px 16px;
    border-radius: 999px;
  }

  #trust-{{ section.id }} .trust__cta {
    margin-top: 40px;
  }
</style>

<section id="trust-{{ section.id }}" aria-labelledby="trust-h2-{{ section.id }}">
  <div class="wrap">
    <h2 class="trust__title" id="trust-h2-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <p class="trust__body">{{ section.settings.body | escape }}</p>
    <div class="trust__badges">
      {%- assign badges = section.settings.badges | split: ',' -%}
      {%- for badge in badges -%}
        <span class="trust__badge">✓ {{ badge | strip | escape }}</span>
      {%- endfor -%}
    </div>
    <div class="trust__cta">
      <a class="btn" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | escape }}</a>
    </div>
    {%- if section.settings.disclaimer != blank -%}
      <p class="fine-print" style="margin-top:24px;color:rgba(255,255,255,0.4)">{{ section.settings.disclaimer | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust strip",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Held to a higher standard." },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "text", "id": "badges", "label": "Badges (comma separated)", "default": "GMP Certified, Third-Party Tested, Made in USA, No Proprietary Blends, No Artificial Colors" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Try Cheat Shot →" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer" }
  ],
  "presets": [{ "name": "Trust strip" }]
}
{% endschema %}
