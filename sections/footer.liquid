<style>
  .footer {
    background: var(--ink);
    color: #fff;
    border-top: 1px solid var(--cream-deep);
    padding: clamp(40px, 6vw, 72px) 0 28px;
  }

  .footer__grid {
    display: grid;
    gap: 36px;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 750px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 48px;
    }
  }

  .footer__brand {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 2.2rem;
    line-height: 0.95;
    margin: 0 0 12px;
  }

  .footer__brand img {
    max-height: 72px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .footer__tagline {
    font-weight: 600;
    max-width: 34ch;
    margin: 0 0 20px;
  }

  .footer__heading {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    color: var(--gold);
    margin: 0 0 14px;
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .footer__list a:hover {
    color: var(--gold);
  }

  .footer__socials {
    display: flex;
    gap: 12px;
    margin-top: 18px;
  }

  .footer__socials a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 2px solid #fff;
  }

  .footer__socials a:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
  }

  .footer__socials svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .footer__bottom {
    margin-top: 40px;
    padding-top: 22px;
    border-top: 2px solid rgba(255, 255, 255, 0.2);
    display: grid;
    gap: 14px;
  }

  .footer__bottom .fine-print {
    opacity: 0.65;
  }
</style>

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <p class="footer__brand">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" loading="lazy" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}">
          {%- else -%}
            <img src="{{ 'cheatshot-logo.svg' | asset_url }}" alt="{{ shop.name | escape }}" loading="lazy" width="220" height="55">
          {%- endif -%}
        </p>

        {%- if section.settings.tagline != blank -%}
          <p class="footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if section.settings.contact_email != blank -%}
          <a href="mailto:{{ section.settings.contact_email }}" class="btn btn--sm btn--ink" style="border-color:#fff">
            {{ 'sections.footer.contact' | t }}
          </a>
        {%- endif -%}

        <div class="footer__socials">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram" rel="noopener" target="_blank">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.4A6.4 6.4 0 1 0 18.4 12 6.4 6.4 0 0 0 12 5.6zm0 10.6A4.2 4.2 0 1 1 16.2 12 4.2 4.2 0 0 1 12 16.2zm6.6-10.9a1.5 1.5 0 1 1-1.5-1.5 1.5 1.5 0 0 1 1.5 1.5z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" aria-label="TikTok" rel="noopener" target="_blank">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.6 5.8a4.3 4.3 0 0 1-1-2.8h-3v11.6a2.4 2.4 0 1 1-1.7-2.3V9.2a5.4 5.4 0 1 0 4.7 5.4V8.9a7.2 7.2 0 0 0 4.2 1.4V7.3a4.3 4.3 0 0 1-3.2-1.5z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" aria-label="Facebook" rel="noopener" target="_blank">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.2-1.5 1.5-1.5h1.7V3.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.2v2.2H7.5V13h2.8v8h3.2z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- assign has_custom_menu = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' and block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
          {%- assign has_custom_menu = true -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_custom_menu -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu' and block.settings.menu.links.size > 0 -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="footer__heading">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <div>
          <p class="footer__heading">Products</p>
          <ul class="footer__list">
            <li><a href="{{ routes.all_products_collection_url }}">Shop all</a></li>
            <li><a href="/products/cheat-shot-capsules">Cheat Shot Capsules</a></li>
            <li><a href="/products/cheat-shot-powder">Cheat Shot Powder</a></li>
          </ul>
        </div>
        <div>
          <p class="footer__heading">Company</p>
          <ul class="footer__list">
            <li><a href="/pages/about">About Cheat Shot</a></li>
            <li><a href="/pages/ingredients">Ingredients</a></li>
          </ul>
        </div>
        <div>
          <p class="footer__heading">Help</p>
          <ul class="footer__list">
            <li><a href="{{ routes.all_products_collection_url }}#faq">FAQ</a></li>
            <li><a href="/pages/contact">Contact Us</a></li>
            <li><a href="/pages/shipping-policy">Shipping Policy</a></li>
            <li><a href="/pages/returns-refunds">Returns &amp; Refunds</a></li>
            <li><a href="/pages/terms-of-service">Terms of Service</a></li>
            <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
          </ul>
        </div>
      {%- endif -%}
    </div>

    <div class="footer__bottom">
      {%- if settings.fda_disclaimer != blank -%}
        <p class="fine-print">{{ settings.fda_disclaimer }}</p>
      {%- endif -%}
      <p class="fine-print">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Two formulas, two jobs. Powder every day for metabolic and antioxidant support; capsules for the higher-carb meals.*"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "info@cheatshot.com"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Company" } }
    ]
  }
}
{% endschema %}
