<style>
  #featured-{{ section.id }} {
    background: {{ section.settings.background }};
    padding: clamp(52px, 7vw, 96px) 0;
  }

  #featured-{{ section.id }} .featured__head {
    display: grid;
    gap: 14px;
    max-width: 60ch;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  #featured-{{ section.id }} .featured__grid {
    display: grid;
    gap: clamp(20px, 3vw, 32px);
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 700px) {
    #featured-{{ section.id }} .featured__grid {
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    }
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  [data-reveal][data-revealed='true'] {
    opacity: 1;
    transform: none;
  }

  .featured__empty {
    border: 3px dashed var(--ink);
    padding: 40px;
    text-align: center;
  }
</style>

<section id="featured-{{ section.id }}" aria-labelledby="featured-heading-{{ section.id }}">
  <div class="wrap">
    <div class="featured__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow eyebrow--gold">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="h1" id="featured-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="lede">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection.products.size == 0 -%}
      {%- assign collection = collections.all -%}
    {%- endif -%}
    {%- if collection.products.size > 0 -%}
      <div class="featured__grid">
        {%- for product in collection.products limit: section.settings.product_limit -%}
          <div data-reveal style="transition-delay: {{ forloop.index0 | times: 70 }}ms">
            {% render 'product-card', card_product: product, show_description: section.settings.show_description %}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="featured__empty">
        <p class="h3">No products found</p>
        <p class="fine-print" style="margin-top:8px">
          Pick a collection for this section in the theme editor.
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pick your format"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Capsules or powder."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Same formula, two ways to take it. Choose whichever fits your routine."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show short description",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FDFCF8"
    }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
