{%- assign has_menu = false -%}
{%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}{%- assign has_menu = true -%}{%- endif -%}
<style>
  .shopify-section-group-header-group {
    position: sticky;
    top: 0;
    z-index: 400;
    width: 100%;
    background: #fff;
  }

  .header {
    position: relative;
    z-index: 400;
    display: block;
    width: 100%;
    background: #fff;
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--cream-deep);
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    height: 76px;
  }

  @media screen and (min-width: 640px) {
    .header__inner {
      height: 96px;
    }
  }

  @media screen and (min-width: 900px) {
    .header__inner {
      grid-template-columns: 1fr auto 1fr;
      height: 124px;
    }
  }

  .header {
    overflow-x: clip;
  }

  .header__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    overflow: hidden;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.9rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .header__logo img {
    height: auto;
    width: auto;
    max-height: 56px;
    max-width: 100%;
    object-fit: contain;
  }

  @media screen and (min-width: 640px) {
    .header__logo img {
      max-height: 72px;
    }
  }

  @media screen and (min-width: 900px) {
    .header__logo img {
      max-height: {{ section.settings.logo_height }}px;
    }
  }

  .header__nav {
    display: none;
    gap: 32px;
    align-items: center;
  }

  @media screen and (min-width: 900px) {
    .header__nav {
      display: flex;
    }
  }

  .header__link {
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0;
    padding: 6px 0;
    color: var(--ink-mid);
    transition: color 0.15s ease;
  }

  .header__link:hover,
  .header__link[aria-current='page'] {
    color: var(--ink);
  }

  .header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
  }

  .header__cta {
    display: none;
  }

  @media screen and (min-width: 900px) {
    .header__cta {
      display: inline-flex;
    }
  }

  .header__cta {
    padding: 10px 24px;
    font-size: 14px;
    border-radius: 999px;
    background: var(--red);
    color: #fff;
    box-shadow: 0 4px 12px rgba(238, 44, 34, 0.2);
  }

  .header__cart {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    transition: background 0.15s ease;
  }

  .header__cart:hover {
    background: var(--cream-dark);
  }

  .header__cart svg {
    width: 22px;
    height: 22px;
    stroke: var(--ink);
    fill: none;
    stroke-width: 2;
  }

  .header__cart-count {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    display: grid;
    place-items: center;
    background: var(--red);
    color: #fff;
    border: 0;
    font-size: 11px;
    font-weight: 700;
    border-radius: 999px;
  }

  .header__burger {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: transparent;
  }

  @media screen and (min-width: 900px) {
    .header__burger {
      display: none;
    }
  }

  .header__burger svg {
    width: 22px;
    height: 22px;
    stroke: var(--ink);
    stroke-width: 2.5;
    fill: none;
  }

  .header__panel {
    border-top: 1px solid var(--cream-deep);
    background: #fff;
    padding: 20px clamp(20px, 4vw, 48px) 28px;
    display: grid;
    gap: 14px;
  }

  .header__panel[hidden] {
    display: none !important;
  }

  @media screen and (min-width: 900px) {
    .header__panel {
      display: none;
    }
  }

  .header__panel a {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 15px;
  }
</style>

<mobile-nav>
  <header class="header">
    <div class="wrap header__inner">
      <button
        class="header__burger"
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="HeaderPanel"
        aria-label="{{ 'sections.header.menu' | t }}"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"/>
        </svg>
      </button>

      <nav class="header__nav" aria-label="Primary">
        {%- if has_menu -%}
          {%- for link in section.settings.menu.links -%}
            <a
              href="{{ link.url }}"
              class="header__link"
              {% if link.active %}aria-current="page"{% endif %}
            >{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}" class="header__link">Products</a>
          <a href="/pages/ingredients" class="header__link">Ingredients</a>
          <a href="/pages/about" class="header__link">About</a>
        {%- endif -%}
      </nav>

      <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }} home">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 600 }}"
            alt="{{ shop.name | escape }}"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
          >
        {%- else -%}
          <img src="{{ 'cheatshot-logo.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="240" height="60">
        {%- endif -%}
      </a>

      <div class="header__actions">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--sm header__cta">
            {{ section.settings.cta_label | escape }}
          </a>
        {%- endif -%}

        <a href="{{ routes.cart_url }}" class="header__cart" data-cart-open aria-label="{{ 'sections.header.cart_count' | t: count: cart.item_count }}">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4H6zM3 6h18M16 10a4 4 0 0 1-8 0" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="header__cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
            {{ cart.item_count }}
          </span>
        </a>
      </div>
    </div>

    <div class="header__panel" id="HeaderPanel" data-nav-panel hidden>
      {%- if has_menu -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">Products</a>
        <a href="/pages/ingredients">Ingredients</a>
        <a href="/pages/about">About</a>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--block">
          {{ section.settings.cta_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </header>
</mobile-nav>

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}
